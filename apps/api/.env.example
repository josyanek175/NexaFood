NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3333

# PostgreSQL próprio — nunca exponha esta URL ao frontend (sem prefixo VITE_)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexafood
DATABASE_POOL_MAX=10

# CORS: lista separada por vírgula. Em development, localhost:5173 já é permitido por padrão.
# Em production, configure explicitamente (nunca use *).
# CORS_ORIGINS=https://app.seudominio.com

# Auth (fase A — backend)
SESSION_COOKIE_NAME=nexa_session
SESSION_TTL_DAYS=14
# PASSWORD_PEPPER=
AUTH_LOGIN_RATE_MAX=10
AUTH_LOGIN_RATE_WINDOW_MS=60000

# Seed local only (required for npm run db:seed). Never commit real passwords.
# DEV_SEED_PASSWORD=
