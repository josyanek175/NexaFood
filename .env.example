# =============================================================================
# Root / shared examples — copy values into the correct app .env files.
# NEVER commit real secrets. Do NOT prefix secrets with VITE_.
# =============================================================================

# --- apps/api (.env) ---
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3333

# PostgreSQL próprio
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexafood
DATABASE_POOL_MAX=10

SESSION_COOKIE_NAME=nexa_session
SESSION_TTL_DAYS=14
# PASSWORD_PEPPER=
# DEV_SEED_PASSWORD=

AUTH_LOGIN_RATE_MAX=10
AUTH_LOGIN_RATE_WINDOW_MS=60000

# --- apps/web (.env) ---
# Frontend público: apenas variáveis VITE_* (nunca DATABASE_URL / SESSION_SECRET)
VITE_API_BASE_URL=http://localhost:3333
